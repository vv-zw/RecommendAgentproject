# Flask 配置
FLASK_APP=movie_recommendation.app
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 服务器配置
HOST=0.0.0.0
PORT=5000

# 数据库配置 (MySQL)
# DATABASE_URL=mysql+mysqlconnector://user:password@host:port/database
DATABASE_URL=mysql+mysqlconnector://root:your-password@127.0.0.1:3306/movie_ai_assistant

# 推荐系统配置
RECOMMENDATION_CACHE_TIMEOUT=300
MAX_RECOMMENDATIONS=20

# 图片代理配置
PROXY_TIMEOUT=15
ALLOWED_IMAGE_DOMAINS=douban.com,img3.doubanio.com,img9.doubanio.com,movie.douban.com

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# 爬虫配置
CRAWLER_RUN_TIME=02:00
# DOUBAN_COOKIE=可选，豆瓣登录 Cookie（格式：bid=xxx; dbcl2=yyy），不配置则使用 Playwright 无头浏览器

# LLM 配置（Agent 智能对话功能必填）
# 获取 DeepSeek API Key：https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-5443ad3d56ef4c8abafa8c2a4da7640f
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
EMBEDDING_MODEL=text-embedding-v2
# 如需切换到 OpenAI，设置 LLM_PROVIDER=openai 并填入 OpenAI Key
# DEEPSEEK_API_KEY=sk-your-openai-api-key-here
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small
DOUBAN_COOKIE=bid=Nm9S4BAkqrU; dbcl2="294930244:gAW9v2FmEn0"