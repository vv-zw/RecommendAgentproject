# Flask 配置
FLASK_APP=movie_recommendation.app
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 服务器配置
HOST=0.0.0.0
PORT=5000

# 数据库配置 (MySQL)
# DATABASE_URL=mysql+mysqlconnector://user:password@host:port/database
DATABASE_URL=mysql+mysqlconnector://root:your-password@127.0.0.1:3306/movie_ai_assistant

# 推荐系统配置
RECOMMENDATION_CACHE_TIMEOUT=300
MAX_RECOMMENDATIONS=20

# 图片代理配置
PROXY_TIMEOUT=15
ALLOWED_IMAGE_DOMAINS=douban.com,img3.doubanio.com,img9.doubanio.com,movie.douban.com

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
