# Flask configuration
FLASK_APP=movie_recommendation.app
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=change-me-to-a-strong-random-secret
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Server configuration
HOST=0.0.0.0
PORT=5000

# PostgreSQL configuration for Docker Compose
DB_ENABLED=true
PGHOST=postgres
PGPORT=5432
PGUSER=postgres
PGPASSWORD=change-me
PGDATABASE=movie_recommendation
DATABASE_URL=postgresql://postgres:change-me@postgres:5432/movie_recommendation

# Recommendation system
RECOMMENDATION_CACHE_TIMEOUT=300
MAX_RECOMMENDATIONS=20

# Image proxy
PROXY_TIMEOUT=15
ALLOWED_IMAGE_DOMAINS=douban.com,img3.doubanio.com,img9.doubanio.com,movie.douban.com

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Crawler
CRAWLER_RUN_TIME=02:00
# Optional Douban login cookie. Keep real cookies only in .env, never in git.
DOUBAN_COOKIE=

# LLM / Agent API
DEEPSEEK_API_KEY=
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
EMBEDDING_MODEL=text-embedding-v2
